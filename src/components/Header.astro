---
import { url } from '../lib/url.js';

const path = Astro.url.pathname.replace(/\/+$/, '') || '/';
const base = url('').replace(/\/+$/, '');
const links = [
  { href: url(''), label: 'Now Showing', match: (p) => p === base || p === '/' },
  { href: url('reviews/'), label: 'Reviews', match: (p) => p.startsWith(`${base}/reviews`) },
  { href: url('hall-of-fame/'), label: 'Hall of Fame', match: (p) => p.startsWith(`${base}/hall-of-fame`) },
  { href: url('about/'), label: 'About', match: (p) => p.startsWith(`${base}/about`) },
];
---
<header class="site-header">
  <div class="container site-header__inner">
    <a class="brand" href={url('')} aria-label="Margheret's Movies home">
      <span class="brand__sign bulbs" aria-hidden="true"><span>M</span></span>
      <span class="brand__name">Margheret's Movies<small>A palace for reviews</small></span>
    </a>

    <nav class="nav" data-nav aria-label="Main">
      {links.map((l) => (
        <a href={l.href} aria-current={l.match(path) ? 'page' : undefined}>{l.label}</a>
      ))}
    </nav>

    <div class="header-actions">
      <a class="icon-btn" href={url('search/')} aria-label="Search reviews">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
      </a>
      <button class="icon-btn theme-toggle" type="button" data-theme-toggle aria-label="Switch to light mode">
        <svg class="moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
        <svg class="sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
      </button>
      <button class="icon-btn menu-toggle" type="button" data-menu-toggle aria-expanded="false" aria-label="Menu">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
      </button>
    </div>
  </div>
</header>
